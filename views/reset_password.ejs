<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Reset Password | Todo App</title>
    <link rel="stylesheet" href="/assets/main.css" />
  </head>
  <body>
    <%- include('partials/login_header') %>

    <main>
      <form method="POST" action="/forgot_password/reset-password">
        <h2>Reset Your Password</h2>

        <% if (typeof error !== 'undefined') { %>
        <div class="error-message"><%= error %></div>
        <% } %>

        <input
          type="password"
          name="password"
          placeholder="New password"
          required
        />
        <input
          type="password"
          name="confirm_password"
          placeholder="Confirm new password"
          required
        />
        <button>Reset</button>
      </form>
    </main>
  </body>
</html>
