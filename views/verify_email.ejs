<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Email Verification | Todo App</title>
    <link rel="stylesheet" href="/assets/main.css" />
  </head>
  <body>
    <%- include('partials/login_header') %>

    <main>
      <h2>Verify Your Email</h2>
      <p>
        We sent a verification code to your email. Enter it below to verify your
        account.
      </p>

      <form method="POST" action="/email_verification/verify_email">
        <input type="hidden" name="email" value="<%= email %>" />

        <input type="text" name="otp" placeholder="Enter OTP" required />
        <button type="submit">Verify</button>
      </form>

      <form method="POST" action="/email_verification/resend_otp">
        <input type="hidden" name="email" value="<%= email %>" />
        <button type="submit">Resend OTP</button>
      </form>

      <% if (typeof error !== 'undefined') { %>
      <div class="error-message"><%= error %></div>
      <% } %> <% if (typeof success !== 'undefined') { %>
      <div class="success-message"><%= success %></div>
      <% } %>
    </main>
  </body>
</html>
