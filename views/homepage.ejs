<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/assets/main.css" />
    <script src="/assets/script.js" defer></script>
    <title>Todo App - Get Things Done</title>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>My Todo App</h1>
        <p>Organize your life, one task at a time</p>
      </div>

      <div class="content">
        <div class="features">
          <div class="feature">
            <div class="feature-icon">📝</div>
            <h3>Simple & Clean</h3>
            <p>Intuitive interface that lets you focus on what matters most</p>
          </div>
          <div class="feature">
            <div class="feature-icon">⚡</div>
            <h3>Lightning Fast</h3>
            <p>
              Add, edit, and complete tasks in seconds with our streamlined
              design
            </p>
          </div>
          <div class="feature">
            <div class="feature-icon">🎯</div>
            <h3>Stay Focused</h3>
            <p>Prioritize tasks and track your progress effortlessly</p>
          </div>
        </div>

        <div class="cta-section">
          <button class="cta-button" onclick="startApp()">Get Started</button>
        </div>
      </div>
    </div>
  </body>
</html>
